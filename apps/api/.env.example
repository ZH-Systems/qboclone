# Server-only environment variables, NEVER VITE_ prefixed
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
WEB_APP_ORIGIN=http://localhost:5173
PORT=3000

# Optional invitation email delivery (verified Resend sending domain)
RESEND_API_KEY=re_...
INVITATION_EMAIL_FROM=Ledger North <invites@example.ca>

# Optional Milestone 7 integrations, all SERVER ONLY
GOOGLE_VISION_API_KEY=
AUTOMATION_WORKER_SECRET=
# Provision a private Supabase Storage bucket named receipts (max 8 MiB).

# Plaid, configured on API only, obtain from Plaid Dashboard
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Generate 32 random bytes, hex encode. Back up key securely, rotation requires re-encryption.
BANK_TOKEN_ENCRYPTION_KEY=
# Intuit Developer OAuth2, redirect must equal configured HTTPS callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://api.example.ca/qbo/connect/callback
QBO_SANDBOX=true
